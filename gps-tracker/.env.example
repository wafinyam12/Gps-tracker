APP_NAME="Sales Daily"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 object storage
# Set VISIT_PHOTOS_DRIVER=s3 to store visit photos in R2.
VISIT_PHOTOS_DRIVER=local
VISIT_PHOTOS_ROOT=crm/visit-photo
VISIT_PHOTOS_BUCKET=
VISIT_PHOTOS_URL=
VISIT_PHOTOS_VISIBILITY=private
VISIT_PHOTOS_PREVIEW_URL_TTL=120

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# SAP outstanding receivable integration
SAP_OUTSTANDING_RECEIVABLE_BASE_URL=https://ite-sap.utomodeck.com/sap/api/v1/cs-outstanding-receivable
SAP_OUTSTANDING_RECEIVABLE_TIMEOUT=15
SAP_OUTSTANDING_RECEIVABLE_CACHE_MINUTES=10

# SAP BP coordinate staging integration
SAP_BP_COORDINATE_BASE_URL=https://ite-sap.utomodeck.com/sap/api/v1/bp-coordinate
# Default assumes GET /bp-coordinate/{db}/{cardcode}; adjust if SAP uses query parameters.
SAP_BP_COORDINATE_GET_URL_TEMPLATE={base}/{db}/{cardcode}
SAP_BP_COORDINATE_TIMEOUT=15
SAP_BP_COORDINATE_TOKEN=
SAP_BP_COORDINATE_API_KEY=
SAP_COORDINATE_MATCH_TOLERANCE_METERS=50
SAP_COORDINATE_VERIFICATION_THRESHOLD_METERS=100
SAP_COORDINATE_MAX_OBSERVATION_ACCURACY_METERS=25
SAP_COORDINATE_OBSERVATION_AGREEMENT_METERS=30

# UD Portal cash payment integration
# Normal flow uses per-branch UD Portal credentials saved in teams.
# These token/username/password values are only fallback credentials.
UDPORTAL_API_BASE_URL=http://udportal.test/api/v1
UDPORTAL_API_TOKEN=
UDPORTAL_API_USERNAME=
UDPORTAL_API_PASSWORD=
UDPORTAL_API_TIMEOUT=15
UDPORTAL_API_TOKEN_CACHE_MINUTES=60
