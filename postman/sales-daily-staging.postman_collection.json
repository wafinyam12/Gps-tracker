{
  "info": {
    "_postman_id": "4a51d0f8-1c21-4b3a-9e2e-6e2c68e7b741",
    "name": "Sales Daily - Staging API",
    "description": "Basic staging API checks for Sales Daily. Run Login first, then authenticated requests will use the saved Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://crm-sales.utomo-dev.xyz/api/v1",
      "type": "string"
    },
    {
      "key": "username",
      "value": "sales-satu",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "device_name",
      "value": "Postman Staging",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Login response contains token', function () {",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json).to.have.nested.property('data.token');",
              "});",
              "",
              "if (json?.data?.token) {",
              "  pm.collectionVariables.set('token', json.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"{{device_name}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Auth - Me",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Current user returned', function () {",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json).to.have.nested.property('data.user');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Stores - Available",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/stores/available",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "stores",
            "available"
          ]
        }
      }
    },
    {
      "name": "Location - Ping",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": -7.2575,\n  \"longitude\": 112.7521,\n  \"accuracy\": 20,\n  \"speed\": 0,\n  \"bearing\": 0,\n  \"battery\": 85,\n  \"is_moving\": false,\n  \"is_mock_location\": false,\n  \"recorded_at\": \"2026-07-06T04:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/location/ping",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "location",
            "ping"
          ]
        }
      }
    },
    {
      "name": "Auth - Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        }
      }
    }
  ]
}
