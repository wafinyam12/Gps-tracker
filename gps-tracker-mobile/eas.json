{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://crm-sales.utomo-dev.xyz/api/v1",
        "EXPO_PUBLIC_OSM_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://crm-sales.utomo-dev.xyz/api/v1",
        "EXPO_PUBLIC_OSM_TILE_URL": "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      }
    }
  }
}
